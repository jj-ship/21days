.tips{background:linear-gradient(180deg,#f0fdf4,#fff);min-height:100vh;padding-bottom:48rpx}.tips__header{padding:40rpx 32rpx 24rpx}.tips__title{color:#166534;display:block;font-size:44rpx;font-weight:700}.tips__subtitle{color:#65a30d;display:block;font-size:26rpx;margin-top:8rpx}.tips__list{padding:0 32rpx}.tips__item{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06);margin-bottom:24rpx;padding:28rpx}.tips__item-head{margin-bottom:12rpx}.tips__item-category{background:#dcfce7;border-radius:20rpx;color:#15803d;display:inline-block;font-size:22rpx;padding:6rpx 16rpx}.tips__item-title{color:#374151;display:block;font-size:32rpx;font-weight:700;margin-bottom:12rpx}.tips__item-content{color:#6b7280;display:block;font-size:28rpx;line-height:1.6}.tips__loading{color:#9ca3af;display:block;font-size:28rpx;padding-top:200rpx;text-align:center}