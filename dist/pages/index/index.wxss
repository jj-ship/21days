.index{background:linear-gradient(180deg,#f0fdf4,#fff);min-height:100vh;padding-bottom:40rpx}.index__header{padding:40rpx 32rpx 24rpx}.index__title{color:#166534;display:block;font-size:44rpx;font-weight:700}.index__subtitle{color:#65a30d;display:block;font-size:28rpx;margin-top:8rpx}.index__swiper{height:920rpx}.index__swiper-item{align-items:center;display:flex;justify-content:center}.index__card-wrap{height:96%;margin:0 auto;width:92%}.index__action{margin-top:24rpx;padding:0 48rpx}.index__btn{border:none;border-radius:48rpx;font-size:32rpx;font-weight:600;height:96rpx;line-height:96rpx;text-align:center}.index__btn--primary{background:linear-gradient(90deg,#22c55e,#16a34a);color:#fff}.index__btn--disabled{background:#e5e7eb;color:#9ca3af}.index__btn::after{border:none}.index__checked{align-items:center;background:#dcfce7;border-radius:48rpx;display:flex;height:96rpx;justify-content:center}.index__checked-icon{background:#22c55e;border-radius:50%;color:#fff;font-size:24rpx;height:40rpx;line-height:40rpx;margin-right:12rpx;text-align:center;width:40rpx}.index__checked-text{color:#15803d;font-size:32rpx;font-weight:600}.index__loading{color:#9ca3af;display:block;font-size:28rpx;padding-top:200rpx;text-align:center}