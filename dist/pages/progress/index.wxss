.progress{background:linear-gradient(180deg,#f0fdf4,#fff);min-height:100vh;padding-bottom:48rpx}.progress__header{padding:40rpx 32rpx 24rpx}.progress__title{color:#166534;display:block;font-size:44rpx;font-weight:700}.progress__subtitle{color:#65a30d;display:block;font-size:26rpx;margin-top:8rpx}.progress__stats{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06);display:flex;justify-content:space-between;margin:0 32rpx 32rpx;padding:24rpx}.progress__stat{flex:1;text-align:center}.progress__stat:not(:last-child){border-right:1rpx solid #f3f4f6}.progress__stat-num{color:#16a34a;display:block;font-size:44rpx;font-weight:700}.progress__stat-label{color:#6b7280;display:block;font-size:24rpx;margin-top:8rpx}.progress__calendar{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06);margin:0 32rpx 32rpx;padding:24rpx}.progress__calendar-title{color:#374151;display:block;font-size:30rpx;font-weight:600;margin-bottom:20rpx}.progress__calendar-grid{display:flex;flex-wrap:wrap;gap:16rpx}.progress__day{align-items:center;aspect-ratio:1;background:#f3f4f6;border-radius:16rpx;display:flex;flex-direction:column;justify-content:center;width:calc(14.28571% - 80rpx/7)}.progress__day--checked{background:#22c55e}.progress__day--missed{background:#fee2e2}.progress__day--today{background:#dcfce7;border:2rpx solid #22c55e}.progress__day--future{background:#f3f4f6}.progress__day-num{color:#374151;font-size:26rpx;font-weight:600}.progress__day-check{color:#fff;font-size:20rpx;margin-top:4rpx}.progress__chart{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06);margin:0 32rpx 32rpx;padding:24rpx}.progress__chart-title{color:#374151;display:block;font-size:30rpx;font-weight:600;margin-bottom:20rpx}.progress__canvas{height:320rpx;width:100%}.progress__loss{color:#16a34a;display:block;font-size:28rpx;font-weight:600;margin-top:16rpx;text-align:center}.progress__actions{display:flex;flex-direction:column;gap:20rpx;padding:0 48rpx}.progress__btn{border:none;border-radius:44rpx;font-size:30rpx;font-weight:600;height:88rpx;line-height:88rpx;text-align:center}.progress__btn--share{background:linear-gradient(90deg,#22c55e,#16a34a);color:#fff}.progress__btn--secondary{background:#f3f4f6;color:#4b5563}.progress__btn::after{border:none}.progress__loading{color:#9ca3af;display:block;font-size:28rpx;padding-top:200rpx;text-align:center}