.checkin{background:linear-gradient(180deg,#f0fdf4,#fff);min-height:100vh;padding-bottom:48rpx}.checkin__header{padding:40rpx 32rpx 24rpx}.checkin__title{color:#166534;display:block;font-size:40rpx;font-weight:700}.checkin__subtitle{color:#65a30d;display:block;font-size:26rpx;margin-top:8rpx}.checkin__card{padding:0 24rpx}.checkin__weight{background:#fff;border-radius:20rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.06);margin:24rpx 32rpx 0;padding:24rpx}.checkin__weight-label{color:#374151;display:block;font-size:28rpx;margin-bottom:16rpx}.checkin__weight-input{background:#f3f4f6;border-radius:12rpx;color:#111827;font-size:30rpx;height:80rpx;padding:0 24rpx}.checkin__action{margin-top:40rpx;padding:0 48rpx}.checkin__btn{background:linear-gradient(90deg,#22c55e,#16a34a);border:none;border-radius:48rpx;color:#fff;font-size:32rpx;font-weight:600;height:96rpx;line-height:96rpx;text-align:center}.checkin__btn::after{border:none}.checkin__done{align-items:center;background:#dcfce7;border-radius:48rpx;display:flex;height:96rpx;justify-content:center}.checkin__done-icon{background:#22c55e;border-radius:50%;color:#fff;font-size:24rpx;height:40rpx;line-height:40rpx;margin-right:12rpx;text-align:center;width:40rpx}.checkin__done-text{color:#15803d;font-size:32rpx;font-weight:600}